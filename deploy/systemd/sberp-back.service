[Unit]
Description=SBerp back (Spring Boot)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
# Oracle 컨테이너가 완전히 뜰 때까지 대기 (healthcheck.sh가 OK를 반환할 때까지 최대 5분).
# sberp-oracle 컨테이너 자체가 없거나 이미 떠 있으면 바로 통과한다.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do docker exec sberp-oracle healthcheck.sh >/dev/null 2>&1 && exit 0; sleep 5; done; echo "oracle 대기 타임아웃 - 그래도 시작 시도"; exit 0'
ExecStart=/home/ubuntu/sberp/deploy/start-back.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
