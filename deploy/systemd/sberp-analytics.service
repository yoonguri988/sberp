[Unit]
Description=SBerp analytics (Django)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do docker exec sberp-oracle healthcheck.sh >/dev/null 2>&1 && exit 0; sleep 5; done; echo "oracle 대기 타임아웃 - 그래도 시작 시도"; exit 0'
ExecStart=/home/ubuntu/sberp/deploy/start-analytics.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
